# Generated by scripts/generate-htaccess.ts — do not hand-edit.
# Regenerate via: npm run parse-dump && npm run generate-redirects && npm run generate-htaccess

RewriteEngine On

# --- Canonical host: force apex, non-www, https ---
RewriteCond %{HTTP_HOST} ^www\.albanynyairporttaxi\.com$ [NC]
RewriteRule ^(.*)$ https://albanynyairporttaxi.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://albanynyairporttaxi.com/$1 [R=301,L]

# --- Next.js dynamic icon/OG routes export as extensionless files; ---
# --- force their real MIME type so browsers/social crawlers read them right ---
<Files "icon">
  ForceType image/png
</Files>
<Files "apple-icon">
  ForceType image/png
</Files>
<Files "opengraph-image">
  ForceType image/png
</Files>


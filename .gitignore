# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# ETL diagnostic output (regenerated by scripts/parse-dump.ts / generate-redirects.ts)
/content/_missing-towns-report.txt

# deploy artifact (regenerated for each upload, not source)
/deploy/site-export.zip
/deploy/_unmapped-redirects.txt

# scratch/ is a disposable working directory — raw Geofabrik OSM extracts
# (~800MB, re-downloaded by scratch/download-osm-extracts.mjs), deploy zips
# (re-packaged per upload), and other one-off build artifacts. None of it is
# source. content/town-hub-local-places.json (the derived, filtered output
# of the OSM extracts that the build actually reads) is tracked normally —
# it lives under content/, not scratch/.
/scratch/
*.osm.pbf

# raw per-county Wikidata SPARQL dumps — an intermediate cache for
# scripts/town-hubs/fetch-town-wikidata.mjs, regenerated by re-running it.
# content/town-hub-wikidata.json (the matched, filtered output) is tracked.
/scripts/town-hubs/wikidata-raw/

# local-only Claude Code permission overrides
/.claude/settings.local.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
